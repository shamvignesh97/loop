{
  "name": "loop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "deploy": "bash scripts/build-pages.sh && gh-pages -d dist",
    "build:pages": "bash scripts/build-pages.sh"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vercel": "^59.12.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.9"
  },
  "description": "Loop — Inbox, ranked."
}
