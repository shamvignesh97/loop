# Optional — local Vite middleware and hosted api/chat read this
XAI_API_KEY=

# Firebase Authentication (Google + Phone) + optional Firestore sync
# Copy to .env.local for Vite; set the same names in Vercel project env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
